{
  "name": "kix-commerce-apps",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kix/web",
    "build": "npm run typecheck -w @kix/protocol-adapter && npm run build -w @kix/web",
    "typecheck": "npm run typecheck -w @kix/protocol-adapter && npm run typecheck -w @kix/web",
    "test": "npm run test -w @kix/protocol-adapter && npm run test -w @kix/web",
    "typecheck:e2e": "npm run typecheck -w @kix/e2e",
    "test:e2e": "npm run test -w @kix/e2e",
    "test:a11y": "npm run test:a11y -w @kix/e2e",
    "test:budget": "npm run test:budget -w @kix/e2e",
    "budget": "node scripts/check-bundle-budget.mjs --dist apps/web/dist --budget apps/web/bundle-budget.json",
    "lint": "node scripts/lint.mjs",
    "coverage:check": "node scripts/coverage-check.mjs",
    "deps:check": "node scripts/deps-check.mjs",
    "audit:warn": "node scripts/audit-warn.mjs",
    "cycle-check": "node scripts/cycle-check.mjs",
    "unused-exports": "node scripts/unused-exports-report.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "knip": "6.40.0",
    "madge": "8.0.0",
    "typescript-eslint": "8.71.2"
  }
}
